{
  "private": true,
  "name": "aurescrm",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "cd commercial && yarn install --check-files --ignore-engines && cd ../bureau && yarn install --check-files --ignore-engines",
    "dev:commercial": "cd commercial && yarn dev",
    "build:commercial": "cd commercial && yarn build",
    "dev:bureau": "cd bureau && yarn dev",
    "build:bureau": "cd bureau && yarn build",
    "build": "yarn build:commercial && yarn build:bureau"
  }
}
